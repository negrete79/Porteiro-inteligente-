rules_version = '2';
// PortaLink — regras Firestore (TESTE — libera tudo).
// Cole isto no console Firebase → Firestore Database → Regras → Publicar.
// DEPOIS de confirmar que admin.html e eu.html estão conectados, troque pelas
// regras de produção (arquivo firestore.rules.prod neste mesmo diretulo).
service cloud.firestore {
  match /databases/{database}/documents {
    match /{document=**} {
      allow read, write: if true;
    }
  }
}
